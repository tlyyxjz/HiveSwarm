{
  "id": "B08",
  "category": "branch",
  "description": "精确匹配 wu 所在行号",
  "setup": {
    "files": {
      "names.txt": "li\nwu\nzhao"
    }
  },
  "solution_steps": [
    {
      "tool": "text_search",
      "args": {
        "path": "names.txt",
        "pattern": "^wu$"
      }
    },
    {
      "tool": "calc",
      "args": {
        "op": "+",
        "a": "$s1",
        "b": 0
      }
    },
    {
      "tool": "write_file",
      "args": {
        "path": "found.txt",
        "content": "HIT:{s2}"
      }
    }
  ],
  "success_criteria": [
    {
      "subject": "file:found.txt",
      "validator_name": "regex_match",
      "params": {
        "pattern": "^HIT:2$"
      }
    }
  ]
}