{
  "id": "G07",
  "category": "guard",
  "description": "单位换算: 2GB=2048MB",
  "setup": {
    "files": {
      "size.txt": "gb:2"
    }
  },
  "solution_steps": [
    {
      "tool": "read_file",
      "args": {
        "path": "size.txt"
      }
    },
    {
      "tool": "extract_number",
      "args": {
        "text": "$s1",
        "occurrence": 1
      }
    },
    {
      "tool": "calc",
      "args": {
        "op": "*",
        "a": "$s2",
        "b": 1024
      }
    },
    {
      "tool": "write_file",
      "args": {
        "path": "mb.txt",
        "content": "MB:{s3}"
      }
    }
  ],
  "success_criteria": [
    {
      "subject": "file:mb.txt",
      "validator_name": "regex_match",
      "params": {
        "pattern": "^MB:2048$"
      }
    }
  ]
}