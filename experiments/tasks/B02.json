{
  "id": "B02",
  "category": "branch",
  "description": "分数>=60 走通过分支",
  "setup": {
    "files": {
      "score.txt": "score:72"
    }
  },
  "solution_steps": [
    {
      "tool": "read_file",
      "args": {
        "path": "score.txt"
      }
    },
    {
      "tool": "extract_number",
      "args": {
        "text": "$s1",
        "occurrence": 1
      }
    },
    {
      "tool": "write_file",
      "args": {
        "path": "grade.txt",
        "content": "PASS:{s2}"
      }
    }
  ],
  "success_criteria": [
    {
      "subject": "file:grade.txt",
      "validator_name": "regex_match",
      "params": {
        "pattern": "^PASS:72$"
      }
    }
  ]
}