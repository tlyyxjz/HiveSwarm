{
  "id": "S02",
  "category": "serial",
  "description": "两文件拼接",
  "setup": {
    "files": {
      "a.txt": "alpha;",
      "b.txt": "omega"
    }
  },
  "solution_steps": [
    {
      "tool": "read_file",
      "args": {
        "path": "a.txt"
      }
    },
    {
      "tool": "read_file",
      "args": {
        "path": "b.txt"
      }
    },
    {
      "tool": "write_file",
      "args": {
        "path": "merged.txt",
        "content": "{s1}{s2}"
      }
    }
  ],
  "success_criteria": [
    {
      "subject": "file:merged.txt",
      "validator_name": "regex_match",
      "params": {
        "pattern": "^alpha;omega$"
      }
    }
  ]
}